{
  "expo": {
    "name": "Daily Expense v2",
    "slug": "daily-spend",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.designabbey.dailyspend",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./modules/payment-reader",
      "expo-splash-screen",
      "expo-sharing"
    ],
    "scheme": "dailyspend",
    "owner": "design-abbey",
    "extra": {
      "eas": {
        "projectId": "1fccf7d3-b5c4-455c-90b6-54d37f066c62"
      }
    }
  }
}
